# Postgres. Either `docker compose up -d db`:
DATABASE_URL=postgresql://ott:ott@localhost:5432/ott
# …or, with no Docker, a local Prisma Postgres (`npx prisma dev -d --name ott -P 51214 --shadow-db-port 51215`):
# (always name the schema: that server shares one session, so an unnamed schema can
#  silently end up pointing at the tests' "test" schema)
# DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&schema=public
# SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&schema=public
# DATABASE_POOL_MAX=1   # that server can't interleave parallel connections

PORT=4000
# Public origin of the web app
WEB_ORIGIN=http://localhost:3000

# Long random string; used to sign session JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay — leave RAZORPAY_KEY_ID empty in development to use "dev payments",
# which lets orders be confirmed instantly without paying.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes a pending order holds its opening-night seats
ORDER_HOLD_MIN=15

# Optional: HMAC key for signing CDN manifest URLs (token auth on your CDN)
CDN_SIGNING_KEY=
PLAYBACK_TTL_SEC=14400

# Optional: Cloudflare R2 for films (`npm run publish-film`) and artwork uploaded in the staff screens.
# Without these, uploads are saved to apps/api/uploads in development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_BASE_URL=
