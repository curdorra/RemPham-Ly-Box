# Postgres (docker compose up -d db)
DATABASE_URL=postgresql://ott:ott@localhost:5432/ott

PORT=4000
# Public origin of the web app (used for Stripe redirect URLs)
WEB_ORIGIN=http://localhost:3000

# Long random string; used to sign session JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Stripe — leave STRIPE_SECRET_KEY empty in development to use "dev billing",
# which activates subscriptions instantly without a payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=

# Optional: HMAC key for signing CDN manifest URLs (token auth on your CDN)
CDN_SIGNING_KEY=
PLAYBACK_TTL_SEC=14400
