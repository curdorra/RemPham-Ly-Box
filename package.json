{
  "name": "rempham-ly-box",
  "private": true,
  "version": "0.1.0",
  "description": "RemPham Ly Box — subscription VOD (OTT) streaming platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @ott/shared && concurrently -n api,web -c blue,magenta \"npm run dev -w @ott/api\" \"npm run dev -w @ott/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @ott/api",
    "db:seed": "npm run db:seed -w @ott/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
